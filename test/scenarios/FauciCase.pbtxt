    source_url: "https://www.cbsnews.com/live-updates/anthony-fauci-rand-paul-covid-origins-senate/"
    source_excerpt: "Paul said the presidential pardon has given Fauci more immunity than most people get."
  }
  expectations { check_type: "CLAIM_EXISTS" claim_id: 4 }
  expectations { check_type: "LINK_EXISTS" from_claim_id: 3 to_claim_id: 4 link_type: "PARENT_CHILD" }
  expectations { check_type: "USER_VIEW" claim_id: 4 username: "Paul" expected_status: "TRUE_CLAIM" }
