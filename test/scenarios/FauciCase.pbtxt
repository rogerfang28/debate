name: "FauciCase"

# =============================================================================
# The Fauci hearing, as a reader would enter it.
#
# One person -- "guest", the reader -- types everything in. Nothing is the reader's own
# claim: every claim is said by someone in the two CBS reports (the hearing
# live blog of July 29, 2026 and the diary story of July 28), entered in
# that person's voice with the article as its source. The voices never log
# in; the reader is a member, they are not.
#
# Claim ids, in creation order:
#
#   1  Paul       Fauci should be held in contempt of Congress (root)
#   2  Paul       Fauci refused every question after being directed to testify
#   3  Paul       The Fifth Amendment privilege is unsupported because of the pardon   [INFERENTIAL]
#   4  Paul       The pardon gave Fauci more immunity than most people get
#   5  Paul       Obstructing an investigation of Congress is against the law     [AUTHORITY]
#   6  Lankford   Congress held Lois Lerner in contempt for testifying then taking the Fifth  [AUTHORITY]
#   7  Fauci      Paul's sole reason for the hearing is to vindicate his pledge that Fauci ends up behind bars  (challenges 1)
#   8  Fauci      Paul released the unredacted diary to embarrass and intimidate
#   9  Fauci      Paul has repeatedly pledged in public that Fauci would end up behind bars
#  10  attorney   Fauci has a valid Fifth Amendment privilege and the right to assert it  (challenges 3)
#  11  Lankford   Invoking the Fifth Amendment is Fauci's constitutional right  (challenges 3)
#  12  Peters     The hearing legitimizes a conclusion Paul reached years ago  (challenges 1)
#  13  Peters     In 2021 Paul called for Fauci to be fired and arrested, and featured him in fundraising
#  14  Peters     The committee has denied the minority access to the investigation's records
#  15  Paul       All of the investigation's records were posted on a website; no Democrat asked for the code  (challenges 14)
#  16  Paul       The hearing's purpose was answers and an apology for funding dangerous research in China  (challenges 7)
#  17  Paul       NIAID funded research in a Wuhan lab that lacked acceptable safety standards
#  18  Fauci      The viruses studied under the NIH grant were so far from SARS-CoV-2 they could not have become it  (challenges 17)
#  19  Paul       Fauci privately doubted the natural-origin story while publicly calling a lab leak implausible  (challenges 18)
#  20  Fauci      I always said natural origin was very highly likely, and called for a thorough investigation  (challenges 19)
#
# What the replay must show at the end:
#   - Paul holds the root; Fauci and Peters hold it false; Lankford holds neither.
#   - The pardon step (3) is false for Lankford and the attorney, and since it
#     is INFERENTIAL that only withdraws support -- it does not sink the root.
#   - Nobody but the reader is a member, yet every voice has a view.
# =============================================================================

steps {
  action {
    username: "guest"
    event_type: "CREATE_USER"
  }
}

steps {
  action {
    username: "guest"
    event_type: "CREATE_DEBATE"
    debate_topic: "Fauci should be held in contempt of Congress for refusing to testify at the Senate Homeland Security Committee hearing."
    voice: "Paul"
    source_url: "https://www.cbsnews.com/live-updates/anthony-fauci-rand-paul-covid-origins-senate/"
    source_excerpt: "this committee has scheduled a vote next week on a resolution certifying your contempt"
  }
}

steps {
  action {
    username: "guest"
    event_type: "JOIN_DEBATE"
    debate_id: 1
  }
}

steps {
  action {
    username: "guest"
    event_type: "ENTER_DEBATE"
    debate_id: 1
  }
  expectations { check_type: "USER_VIEW" claim_id: 1 username: "Paul" expected_status: "TRUE_CLAIM" }
  expectations { check_type: "USER_VIEW" claim_id: 1 username: "guest" expected_status: "UNDETERMINED" }
}

steps {
  action {
    username: "guest"
    event_type: "GO_TO_CLAIM"
    claim_id: 1
  }
}

steps {
  action {
    username: "guest"
    event_type: "ADD_CHILD_CLAIM"
    claim_text: "Fauci refused to answer every question from senators after being directed to testify."
    voice: "Paul"
    basis: "EVIDENTIAL"
    source_url: "https://www.cbsnews.com/live-updates/anthony-fauci-rand-paul-covid-origins-senate/"
    source_excerpt: "Fauci continued to invoke his Fifth Amendment rights to every question from senators."
  }
  expectations { check_type: "CLAIM_EXISTS" claim_id: 2 }
  expectations { check_type: "LINK_EXISTS" from_claim_id: 1 to_claim_id: 2 link_type: "PARENT_CHILD" }
  expectations { check_type: "USER_VIEW" claim_id: 2 username: "Paul" expected_status: "TRUE_CLAIM" }
}

steps {
  action {
    username: "guest"
    event_type: "GO_TO_CLAIM"
    claim_id: 1
  }
}

steps {
  action {
    username: "guest"
    event_type: "ADD_CHILD_CLAIM"
    claim_text: "Fauci's Fifth Amendment privilege is unsupported because he holds an unlimited presidential pardon."
    voice: "Paul"
    basis: "INFERENTIAL"
    source_url: "https://www.cbsnews.com/live-updates/anthony-fauci-rand-paul-covid-origins-senate/"
    source_excerpt: "Because you refuse to answer, citing a privilege that is unsupported because of your pardon"
  }
  expectations { check_type: "CLAIM_EXISTS" claim_id: 3 }
  expectations { check_type: "LINK_EXISTS" from_claim_id: 1 to_claim_id: 3 link_type: "PARENT_CHILD" }
  expectations { check_type: "USER_VIEW" claim_id: 3 username: "Paul" expected_status: "TRUE_CLAIM" }
}

