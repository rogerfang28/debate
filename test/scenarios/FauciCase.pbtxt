  expectations { check_type: "LINK_EXISTS" from_claim_id: 1 to_claim_id: 6 link_type: "PARENT_CHILD" }
  expectations { check_type: "USER_VIEW" claim_id: 6 username: "Lankford" expected_status: "TRUE_CLAIM" }
