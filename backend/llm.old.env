# RETIRED 2026-10-30: nothing listens on :8002 any more (the cubic5090 Qwen
# session says only :8090 is served). Kept for the record; use -Llm new.
#
# The older model server: Qwen 3.6 35B-A3B, 3-bit. It shares the GPU with
# the Qwen 3.8 server, so only one of the two is up at a time; this one runs
# only when someone has switched back. Loaded by backend/start-server.ps1
# -Llm old. Context about 18,700 tokens per request (7 parallel slots).
DEBATE_LLM_HOST=192.168.86.124
DEBATE_LLM_PORT=8002
DEBATE_LLM_PATH=/v1/chat/completions
DEBATE_LLM_MODEL=Qwen3.6-35B-A3B-UD-Q3_K_XL.gguf
DEBATE_LLM_API_KEY=
DEBATE_LLM_MAX_TOKENS=4000
DEBATE_LLM_TIMEOUT_SEC=600
