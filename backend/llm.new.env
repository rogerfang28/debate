# The model server that is normally up: Qwen 3.8 27B, 4-bit.
# Loaded by backend/start-server.ps1 -Llm new (the default). These are also
# the backend's built-in defaults, so this file documents more than it changes.
# Context 262,144 tokens; one request at a time, others queue (up to 10 min).
# Reached over Tailscale (tailnet cubicwork2000@): cubic5090 is 100.117.199.95,
# also cubic5090.tail637f65.ts.net. Works from any network once this machine
# is on the tailnet; on the home LAN 192.168.86.124 also works.
DEBATE_LLM_HOST=100.117.199.95
DEBATE_LLM_PORT=8090
DEBATE_LLM_PATH=/v1/chat/completions
DEBATE_LLM_MODEL=qwen3.8-27b
DEBATE_LLM_API_KEY=
DEBATE_LLM_MAX_TOKENS=4000
DEBATE_LLM_TIMEOUT_SEC=600
